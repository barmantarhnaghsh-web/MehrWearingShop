# ------------------------------------------------------------------
# MehrWearingShop - root environment (used by docker-compose)
# Copy to .env and adjust values before running `docker compose up`
# ------------------------------------------------------------------

# --- API ---
API_PORT=4000
# SQLAlchemy-style URL; docker-compose sets internal host automatically
DATABASE_URL=postgresql://mwr:mwr@localhost:5432/mwrshop?schema=public
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars-long!!
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars-long!
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
# Public base URL of the web app (CORS + payment redirects)
CORS_ORIGIN=http://localhost:3000
# Public base URL of the API (used in payment gateway callbacks)
API_PUBLIC_URL=http://localhost:4000
# Public base URL of the web app (payment success redirect)
WEB_PUBLIC_URL=http://localhost:3000
# Payment provider: mock | zarinpal | cod
PAYMENT_PROVIDER=mock
ZARINPAL_MERCHANT_ID=
ZARINPAL_SANDBOX=true
# Seed an admin account on `npm run db:seed`
ADMIN_EMAIL=admin@mwrshop.ir
ADMIN_PASSWORD=Admin@1234
ADMIN_PHONE=09120000001

# --- Web ---
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1

# --- Postgres (docker-compose) ---
POSTGRES_USER=mwr
POSTGRES_PASSWORD=mwr
POSTGRES_DB=mwrshop
