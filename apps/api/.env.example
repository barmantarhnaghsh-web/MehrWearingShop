# MehrWearingShop API environment
NODE_ENV=development
API_PORT=4000

# PostgreSQL connection string
DATABASE_URL=postgresql://mwr:mwr@localhost:5432/mwrshop?schema=public

# JWT (use long random strings in production, e.g. `openssl rand -hex 32`)
JWT_ACCESS_SECRET=dev-access-secret-change-me-0123456789abcdef
JWT_REFRESH_SECRET=dev-refresh-secret-change-me-0123456789abcdef
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30

# CORS / public URLs
CORS_ORIGIN=http://localhost:3000
API_PUBLIC_URL=http://localhost:4000
WEB_PUBLIC_URL=http://localhost:3000

# Payments: mock | zarinpal | cod
PAYMENT_PROVIDER=mock
ZARINPAL_MERCHANT_ID=
ZARINPAL_SANDBOX=true

# Admin account created by the seed script
ADMIN_EMAIL=admin@mwrshop.ir
ADMIN_PASSWORD=Admin@1234
ADMIN_PHONE=09120000001

# Auth endpoints rate limit (per 15 min per IP)
AUTH_RATE_LIMIT=30
